{
  "manifest_version": 3,
  "name": "YouTube Global Controls",
  "version": "1.1.0",
  "description": "Global YouTube shortcuts: play/pause, next/previous, seek, mute, volume, speed and Picture-in-Picture. Pins the tab while playing.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Global Controls",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "toggle-play-pause": {
      "suggested_key": {
        "default": "Ctrl+Shift+1",
        "mac": "Command+Shift+1"
      },
      "global": true,
      "description": "Toggle YouTube video play/pause globally"
    },
    "toggle-pip": {
      "suggested_key": {
        "default": "Ctrl+Shift+2",
        "mac": "Command+Shift+2"
      },
      "global": true,
      "description": "Toggle Picture-in-Picture mode"
    },
    "backward-10s": {
      "suggested_key": {
        "default": "Ctrl+Shift+9",
        "mac": "Command+Shift+9"
      },
      "global": true,
      "description": "Skip backward 10 seconds"
    },
    "forward-10s": {
      "suggested_key": {
        "default": "Ctrl+Shift+0",
        "mac": "Command+Shift+0"
      },
      "global": true,
      "description": "Skip forward 10 seconds"
    },
    "next-video": {
      "description": "Next video"
    },
    "previous-video": {
      "description": "Previous video"
    },
    "toggle-mute": {
      "description": "Mute / unmute"
    },
    "volume-up": {
      "description": "Volume up 10%"
    },
    "volume-down": {
      "description": "Volume down 10%"
    },
    "speed-up": {
      "description": "Speed up playback"
    },
    "speed-down": {
      "description": "Slow down playback"
    }
  }
}
