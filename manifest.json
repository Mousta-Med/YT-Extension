{
  "manifest_version": 3,
  "name": "YouTube Global Controls",
  "version": "1.0.0",
  "description": "Global shortcuts for YouTube play/pause, 10s seek and Picture-in-Picture. Pins the tab while a video is playing.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "toggle-play-pause": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "global": true,
      "description": "Toggle YouTube video play/pause globally"
    },
    "toggle-pip": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "global": true,
      "description": "Toggle Picture-in-Picture mode"
    },
    "backward-10s": {
      "suggested_key": {
        "default": "Ctrl+Shift+Left",
        "mac": "Command+Shift+Left"
      },
      "global": true,
      "description": "Skip backward 10 seconds"
    },
    "forward-10s": {
      "suggested_key": {
        "default": "Ctrl+Shift+Right",
        "mac": "Command+Shift+Right"
      },
      "global": true,
      "description": "Skip forward 10 seconds"
    }
  }
} 